<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'en' ? 'ltr' : 'rtl' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fair Intelligence | <%= __('systemSubtitle') %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* Global High-Fidelity Official Print Layout Stylesheet */
        @media print {
            :root {
                --accent-color: #0F172A !important; /* Executive Dark Charcoal Navy */
                --accent-hover: #1E293B !important;
                --accent-light: #F8FAFC !important; /* Premium light slate white */
                --accent-border: #E2E8F0 !important;
                --accent-gradient: none !important;
                --text-primary: #000000 !important; /* Pure black for high-readability printing */
                --text-secondary: #475569 !important; /* Formal secondary slate grey */
                --bg-dark: #FFFFFF !important; /* Save printer ink, pure white backgrounds */
                --bg-card: #FFFFFF !important;
                --glass-border: #E2E8F0 !important;
                --shadow-soft: none !important;
                --shadow-medium: none !important;
            }
            
            body {
                background-color: #FFFFFF !important;
                color: #000000 !important;
                font-size: 10pt !important;
            }

            /* Formal table adjustments */
            table, th, td {
                border-color: #94A3B8 !important;
                color: #000000 !important;
                text-align: center !important;
            }

            thead th, th.bg-gray, td.bg-gray {
                background-color: #F1F5F9 !important; /* Clean corporate table headers */
                color: #0F172A !important;
                font-weight: 800 !important;
            }

            .card {
                box-shadow: none !important;
                border: 1px solid #CBD5E1 !important;
                background: #FFFFFF !important;
            }
        }
    </style>
</head>
<body>
    <div class="mobile-header no-print">
        <img src="/logo.webp" alt="Logo" style="height: 35px;">
        <span style="font-weight: 800; letter-spacing: 1px; font-size: 0.9rem; color: var(--text-primary);"><%= __('systemName') %></span>
    </div>

    <div class="sidebar no-print">
        <div class="sidebar-brand-wrapper">
            <img src="/logo.webp" alt="Logo" class="sidebar-logo">
            <h2 class="sidebar-brand-title"><%= __('systemName') %></h2>
            <p class="sidebar-brand-subtitle"><%= __('systemSubtitle') %></p>
        </div>
        <nav class="sidebar-nav-container">
            <a href="/" class="nav-link <%= typeof page !== 'undefined' && page === 'dashboard' ? 'active' : '' %>">
                <i class="fas fa-grid-2"></i> <span><%= __('dashboard') %></span>
            </a>
            <a href="/upload" class="nav-link <%= typeof page !== 'undefined' && page === 'upload' ? 'active' : '' %>">
                <i class="fas fa-plus-square"></i> <span><%= __('uploadReports') %></span>
            </a>
            <a href="/reports/history" class="nav-link <%= typeof page !== 'undefined' && page === 'history' ? 'active' : '' %>">
                <i class="fas fa-folder-open"></i> <span><%= __('reportsHistory') %></span>
            </a>
            <a href="/analytics/total" class="nav-link <%= typeof page !== 'undefined' && page === 'total' ? 'active' : '' %>">
                <i class="fas fa-analytics"></i> <span><%= __('cumulativeReport') %></span>
            </a>
            <a href="/teams" class="nav-link <%= typeof page !== 'undefined' && page === 'teams' ? 'active' : '' %>">
                <i class="fas fa-users"></i> <span><%= __('manageTeams') %></span>
            </a>
            <a href="/logout" class="nav-link logout-link">
                <i class="fas fa-sign-out-alt"></i> <span><%= __('logout') %></span>
            </a>
        </nav>
        
        <!-- Premium Dual-Language Pill Toggle -->
        <div style="margin: 1.5rem 0 0.5rem; padding: 0 0.5rem; display: flex; justify-content: center;">
            <div style="background: rgba(214, 51, 108, 0.05); border: 1px solid var(--accent-border); padding: 4px; border-radius: 12px; display: flex; width: 100%; gap: 4px;">
                <a href="/set-lang/ar" style="flex: 1; text-align: center; padding: 6px 12px; font-size: 0.8rem; font-weight: bold; border-radius: 8px; text-decoration: none; color: <%= lang === 'ar' ? 'white' : 'var(--text-secondary)' %>; background: <%= lang === 'ar' ? 'var(--accent-gradient)' : 'transparent' %>; box-shadow: <%= lang === 'ar' ? '0 4px 10px rgba(214, 51, 108, 0.15)' : 'none' %>; transition: all 0.3s ease;">
                    العربية
                </a>
                <a href="/set-lang/en" style="flex: 1; text-align: center; padding: 6px 12px; font-size: 0.8rem; font-weight: bold; border-radius: 8px; text-decoration: none; color: <%= lang === 'en' ? 'white' : 'var(--text-secondary)' %>; background: <%= lang === 'en' ? 'var(--accent-gradient)' : 'transparent' %>; box-shadow: <%= lang === 'en' ? '0 4px 10px rgba(214, 51, 108, 0.15)' : 'none' %>; transition: all 0.3s ease;">
                    English
                </a>
            </div>
        </div>

        <div class="sidebar-footer-card">
            <p><%= __('systemVersion') %></p>
        </div>
    </div>
    
    <div class="main-content">
        <%- body %>
    </div>
</body>
</html>
