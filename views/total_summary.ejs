<div class="only-print standard-print">
    <div class="print-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--accent-color); padding-bottom: 1.5rem; margin-bottom: 2rem;">
        <div style="text-align: right;">
            <img src="/logo.webp" alt="Logo" style="height: 65px; margin-bottom: 0.5rem;">
            <h2 style="font-weight: 800; margin: 0; color: var(--bg-dark); letter-spacing: 1px;">FAIR INTELLIGENCE</h2>
            <p style="margin: 0; font-size: 0.75rem; color: var(--accent-color); text-transform: uppercase; font-weight: bold;">Cumulative Sales Intelligence Report</p>
        </div>
        <div style="text-align: left; color: #000; font-size: 0.9rem;">
            <p style="margin: 0;">نطاق التقرير: <%= filters.startDate && filters.endDate ? filters.startDate + ' إلى ' + filters.endDate : 'كافة البيانات' %></p>
            <p style="margin: 0;">تاريخ الاستخراج: <%= new Date().toLocaleDateString('ar-EG') %></p>
            <p style="margin: 0;">توقيت الطباعة: <%= new Date().toLocaleString('ar-EG') %></p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="excel-table">
            <thead>
                <tr>
                    <th rowspan="2">Channel</th>
                    <th rowspan="2">Campaign</th>
                    <th colspan="12">State</th>
                    <th rowspan="2">Total Leads</th>
                </tr>
                <tr>
                    <th>My Fresh</th>
                    <th>Call Back</th>
                    <th>Follow Up</th>
                    <th>EOI</th>
                    <th>Hot Case</th>
                    <th>Follow Up low badget</th>
                    <th>Done Deal</th>
                    <th>Prospect</th>
                    <th>Meeting</th>
                    <th>Schedule meeting</th>
                    <th>Not intersted</th>
                    <th>Wrong Number</th>
                </tr>
            </thead>
            <tbody>
                <% campaignSummary.forEach(c => { %>
                <tr>
                    <td class="bg-gray"><%= c.channel %></td>
                    <td class="text-right"><%= c.campaign %></td>
                    <td><%= c.my_fresh || '' %></td>
                    <td><%= c.callback || '' %></td>
                    <td><%= c.follow_up || '' %></td>
                    <td><%= c.eoi || '' %></td>
                    <td><%= c.hot_case || '' %></td>
                    <td><%= c.follow_up_low || '' %></td>
                    <td><%= c.done_deal || '' %></td>
                    <td><%= c.prospect || '' %></td>
                    <td><%= c.meeting || '' %></td>
                    <td><%= c.schedule_meeting || '' %></td>
                    <td><%= c.not_interested || '' %></td>
                    <td><%= c.wrong_number || '' %></td>
                    <td class="bg-gray" style="font-weight: bold;"><%= c.total %></td>
                </tr>
                <% }) %>
                <tr class="bg-total">
                    <td colspan="2">Total</td>
                    <td><%= totalFresh %></td>
                    <td><%= totalCallback %></td>
                    <td><%= totalFollowUp %></td>
                    <td><%= totalEOI %></td>
                    <td><%= totalHot %></td>
                    <td><%= totalLow %></td>
                    <td><%= totalDone %></td>
                    <td><%= totalProspect %></td>
                    <td><%= totalMeeting %></td>
                    <td><%= totalSchedule %></td>
                    <td><%= totalNotInt %></td>
                    <td><%= totalWrong %></td>
                    <td><%= grandTotal %></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="print-header page-break" style="text-align: center; margin-top: 2rem;">
        <h3 style="border: 1px solid #000; padding: 10px; display: inline-block; color: #000;">أداء الموظفين التراكمي</h3>
    </div>

    <div class="table-responsive" style="margin-top: 1rem;">
        <table class="excel-table">
            <thead>
                <tr>
                    <th>اسم الموظف</th>
                    <th>My Fresh</th>
                    <th>Call Back</th>
                    <th>Follow Up</th>
                    <th>EOI</th>
                    <th>Hot Case</th>
                    <th>Follow Up low badget</th>
                    <th>Done Deal</th>
                    <th>Prospect</th>
                    <th>Meeting</th>
                    <th>Schedule meeting</th>
                    <th>Not intersted</th>
                    <th>Wrong Number</th>
                    <th>إجمالي العملاء</th>
                    <th>النسبة</th>
                </tr>
            </thead>
            <tbody>
                <% summary.forEach(s => { %>
                <tr>
                    <td class="text-right"><%= s.salesman_name || 'غير معروف' %></td>
                    <td><%= s.my_fresh || '' %></td>
                    <td><%= s.callback || '' %></td>
                    <td><%= s.follow_up || '' %></td>
                    <td><%= s.eoi || '' %></td>
                    <td><%= s.hot_case || '' %></td>
                    <td><%= s.follow_up_low || '' %></td>
                    <td><%= s.done_deal || '' %></td>
                    <td><%= s.prospect || '' %></td>
                    <td><%= s.meeting || '' %></td>
                    <td><%= s.schedule_meeting || '' %></td>
                    <td><%= s.not_interested || '' %></td>
                    <td><%= s.wrong_number || '' %></td>
                    <td class="bg-gray"><%= s.total %></td>
                    <td><%= grandTotal > 0 ? (s.total / grandTotal * 100).toFixed(1) : 0 %>%</td>
                </tr>
                <% }) %>
                <tr class="bg-total">
                    <td>إجمالي</td>
                    <td><%= totalFresh %></td>
                    <td><%= totalCallback %></td>
                    <td><%= totalFollowUp %></td>
                    <td><%= totalEOI %></td>
                    <td><%= totalHot %></td>
                    <td><%= totalLow %></td>
                    <td><%= totalDone %></td>
                    <td><%= totalProspect %></td>
                    <td><%= totalMeeting %></td>
                    <td><%= totalSchedule %></td>
                    <td><%= totalNotInt %></td>
                    <td><%= totalWrong %></td>
                    <td><%= grandTotal %></td>
                    <td>100%</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


