<% 
    const totalFresh = campaignSummary.reduce((a, b) => a + (b.my_fresh || 0), 0);
    const totalCallback = campaignSummary.reduce((a, b) => a + (b.callback || 0), 0);
    const totalFollowUp = campaignSummary.reduce((a, b) => a + (b.follow_up || 0), 0);
    const totalEOI = campaignSummary.reduce((a, b) => a + (b.eoi || 0), 0);
    const totalHot = campaignSummary.reduce((a, b) => a + (b.hot_case || 0), 0);
    const totalLow = campaignSummary.reduce((a, b) => a + (b.follow_up_low || 0), 0);
    const totalDone = campaignSummary.reduce((a, b) => a + (b.done_deal || 0), 0);
    const totalProspect = campaignSummary.reduce((a, b) => a + (b.prospect || 0), 0);
    const totalMeeting = campaignSummary.reduce((a, b) => a + (b.meeting || 0), 0);
    const totalSchedule = campaignSummary.reduce((a, b) => a + (b.schedule_meeting || 0), 0);
    const totalNotInt = campaignSummary.reduce((a, b) => a + (b.not_interested || 0), 0);
    const totalWrong = campaignSummary.reduce((a, b) => a + (b.wrong_number || 0), 0);
    const grandTotal = campaignSummary.reduce((a, b) => a + b.total, 0);

    let activeFilterText = '';
    if (filters.teamId) {
        const currentTeamObj = teams.find(t => t.id == filters.teamId);
        if (currentTeamObj) {
            activeFilterText = `${lang === 'en' ? 'Team' : 'فريق'}: ${currentTeamObj.name}`;
        }
    } else if (filters.salesmen.length > 0) {
        activeFilterText = `${lang === 'en' ? 'Included Employees' : 'الموظفون المشمولون'}: ${filters.salesmen.join(lang === 'en' ? ', ' : '، ')}`;
    } else {
        activeFilterText = lang === 'en' ? 'All Employees' : 'جميع الموظفين';
    }
%>

<div class="no-print">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 15px;">
        <div>
            <h1><%= __('comprehensiveReport') %></h1>
            <p style="color: var(--text-secondary);"><%= lang === 'en' ? 'Cumulative analysis of marketing campaigns and employee performance' : 'تحليل تراكمي لكافة الحملات التسويقية وأداء الموظفين' %></p>
        </div>
        <button onclick="printStandardReport()" class="btn-premium">
            <i class="fas fa-print"></i> &nbsp; <%= lang === 'en' ? 'Export print copy' : 'استخراج نسخة للطباعة' %>
        </button>
    </div>

    <!-- Filters -->
    <div class="card" style="padding: 1.5rem; margin-bottom: 2rem; background: var(--bg-card); border: 1px solid var(--accent-border); box-shadow: var(--shadow-soft);">
        <form id="filterForm" action="/analytics/total" method="GET" style="display: flex; gap: 20px; align-items: flex-end; flex-wrap: wrap;">
            <div class="filter-group" style="flex: 1.5; min-width: 280px;">
                <label style="display: block; margin-bottom: 0.8rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;"><%= __('searchDateRange') %></label>
                <div class="date-container" style="display: flex; gap: 0; background: rgba(214, 51, 108, 0.03); padding: 5px; border-radius: 16px; border: 1px solid var(--accent-border);">
                    <div style="flex: 1; display: flex; align-items: center; gap: 10px; padding: 5px 15px; border-inline-end: 1px solid var(--accent-border); border-left: none; border-right: none;">
                        <i class="fas fa-calendar-alt" style="color: var(--accent-color); opacity: 0.7; font-size: 0.9rem;"></i>
                        <input type="text" id="startDate" name="startDate" value="<%= filters.startDate %>" placeholder="<%= lang === 'en' ? 'From Date' : 'من تاريخ' %>" style="width: 100%; border: none; background: transparent; color: var(--text-primary); font-weight: 700; outline: none; font-size: 0.95rem;">
                    </div>
                    <div style="flex: 1; display: flex; align-items: center; gap: 10px; padding: 5px 15px;">
                        <i class="fas fa-calendar-check" style="color: var(--accent-color); opacity: 0.7; font-size: 0.9rem;"></i>
                        <input type="text" id="endDate" name="endDate" value="<%= filters.endDate %>" placeholder="<%= lang === 'en' ? 'To Date' : 'إلى تاريخ' %>" style="width: 100%; border: none; background: transparent; color: var(--text-primary); font-weight: 700; outline: none; font-size: 0.95rem;">
                    </div>
                </div>
            </div>

            <div class="filter-group" style="flex: 1; min-width: 200px;">
                <label style="display: block; margin-bottom: 0.8rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;"><%= __('filterByTeam') %></label>
                <div style="display: flex; align-items: center; gap: 10px; background: rgba(214, 51, 108, 0.03); padding: 12px 15px; border-radius: 16px; border: 1px solid var(--accent-border);">
                    <i class="fas fa-users" style="color: var(--accent-color); opacity: 0.7; font-size: 0.9rem;"></i>
                    <select id="teamId" name="teamId" onchange="toggleFilterType()" style="width: 100%; border: none; background: transparent; color: var(--text-primary); font-weight: 700; outline: none; font-size: 0.95rem; cursor: pointer;">
                        <option value=""><%= __('allEmployeesNoTeam') %></option>
                        <% teams.forEach(t => { %>
                            <option value="<%= t.id %>" <%= filters.teamId == t.id ? 'selected' : '' %>><%= t.name %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div class="filter-group" id="salesmenFilterGroup" style="flex: 1.2; min-width: 240px; position: relative;">
                <label style="display: block; margin-bottom: 0.8rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;"><%= __('selectSpecificEmployees') %></label>
                <div id="salesmenSelector" onclick="toggleSalesmenDropdown(event)" style="display: flex; align-items: center; justify-content: space-between; gap: 10px; background: rgba(214, 51, 108, 0.03); padding: 12px 15px; border-radius: 16px; border: 1px solid var(--accent-border); cursor: pointer;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-user-tag" style="color: var(--accent-color); opacity: 0.7; font-size: 0.9rem;"></i>
                        <span id="selectedSalesmenLabel" style="color: var(--text-primary); font-weight: 700; font-size: 0.95rem;">
                            <%= filters.salesmen.length > 0 ? `${filters.salesmen.length} ${__('selectedCount')}` : __('chooseEmployees') %>
                        </span>
                    </div>
                    <i class="fas fa-chevron-down" style="font-size: 0.8rem; opacity: 0.7;"></i>
                </div>
                
                <div id="salesmenDropdownList" style="display: none; position: absolute; top: calc(100% + 5px); right: 0; left: 0; background: white; border: 1px solid var(--accent-border); border-radius: 16px; box-shadow: var(--shadow-medium); z-index: 100; max-height: 250px; overflow-y: auto; padding: 10px; flex-direction: column; gap: 5px;">
                    <div style="position: sticky; top: 0; background: white; padding-bottom: 8px; border-bottom: 1px solid rgba(214,51,108,0.05); margin-bottom: 5px;">
                        <input type="text" id="salesmenSearch" onkeyup="filterSalesmenList()" placeholder="<%= __('searchEmployeePlaceholder') %>" style="width: 100%; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--accent-border); font-size: 0.85rem; outline: none;">
                    </div>
                    <% allSalesmen.forEach(salesman => { %>
                        <label class="salesman-dropdown-item" style="display: flex; align-items: center; gap: 10px; padding: 6px 10px; border-radius: 8px; cursor: pointer; transition: background 0.2s;">
                            <input type="checkbox" name="salesmen" value="<%= salesman %>" onchange="updateSelectedSalesmenCount()" <%= filters.salesmen.includes(salesman) ? 'checked' : '' %> style="accent-color: var(--accent-color); width: 16px; height: 16px;">
                            <span class="salesman-dropdown-name" style="font-size: 0.85rem; font-weight: 600; color: var(--text-primary);"><%= salesman %></span>
                        </label>
                    <% }) %>
                </div>
            </div>
            
            <div class="filter-actions" style="display: flex; gap: 10px; margin-bottom: 5px; flex-wrap: wrap;">
                <button type="submit" class="btn btn-primary" style="padding: 0.8rem 2.5rem; border-radius: 14px; flex: 1;">
                    <i class="fas fa-search"></i> &nbsp; <%= __('analyzeDataBtn') %>
                </button>
                <a href="/analytics/total" class="btn" style="background: rgba(214, 51, 108, 0.05); color: var(--accent-color); text-decoration: none; padding: 0.8rem 1.5rem; border-radius: 14px; border: 1px solid var(--accent-border); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-undo"></i>
                </a>
            </div>

            <!-- Quick Presets -->
            <div style="width: 100%; display: flex; gap: 8px; margin-top: 1.2rem; padding-top: 1.2rem; border-top: 1px solid var(--accent-border); flex-wrap: wrap;">
                <span style="color: var(--text-secondary); font-size: 0.8rem; align-self: center; margin-inline-end: 10px; font-weight: 600;"><%= __('shortcuts') %>:</span>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <button type="button" class="btn-preset" onclick="setPreset('today')"><%= __('today') %></button>
                    <button type="button" class="btn-preset" onclick="setPreset('yesterday')"><%= __('yesterday') %></button>
                    <button type="button" class="btn-preset" onclick="setPreset('week')"><%= __('last7Days') %></button>
                    <button type="button" class="btn-preset" onclick="setPreset('month')"><%= __('thisMonth') %></button>
                </div>
            </div>
        </form>
        
        <% if (filters.startDate && filters.endDate) { %>
            <div style="margin-top: 1.5rem; display: inline-flex; align-items: center; gap: 8px; background: var(--accent-light); color: var(--accent-color); padding: 6px 15px; border-radius: 10px; font-size: 0.85rem; border: 1px solid var(--accent-border); font-weight: 700;">
                <i class="fas fa-info-circle"></i> <%= __('showingResultsPeriod') %>
            </div>
        <% } %>
    </div>

    <style>
        .salesman-dropdown-item:hover {
            background: var(--accent-light);
        }
    </style>
    <script>
        function toggleSalesmenDropdown(event) {
            event.stopPropagation();
            const list = document.getElementById('salesmenDropdownList');
            if (list.style.display === 'none' || list.style.display === '') {
                list.style.display = 'flex';
            } else {
                list.style.display = 'none';
            }
        }

        function filterSalesmenList() {
            const query = document.getElementById('salesmenSearch').value.toLowerCase().trim();
            const items = document.querySelectorAll('.salesman-dropdown-item');
            items.forEach(item => {
                const name = item.querySelector('.salesman-dropdown-name').innerText.toLowerCase();
                if (name.includes(query)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        function updateSelectedSalesmenCount() {
            const checkboxes = document.querySelectorAll('input[name="salesmen"]:checked');
            const label = document.getElementById('selectedSalesmenLabel');
            if (checkboxes.length > 0) {
                label.innerText = `${checkboxes.length} <%= __('selectedCount') %>`;
            } else {
                label.innerText = '<%= __('chooseEmployees') %>';
            }
        }

        function toggleFilterType() {
            const teamSelect = document.getElementById('teamId');
            const selectorGroup = document.getElementById('salesmenFilterGroup');
            const checkboxes = document.querySelectorAll('input[name="salesmen"]');
            
            if (teamSelect.value !== '') {
                selectorGroup.style.opacity = '0.5';
                selectorGroup.style.pointerEvents = 'none';
                checkboxes.forEach(cb => cb.checked = false);
                updateSelectedSalesmenCount();
                document.getElementById('salesmenDropdownList').style.display = 'none';
            } else {
                selectorGroup.style.opacity = '1';
                selectorGroup.style.pointerEvents = 'auto';
            }
        }

        window.addEventListener('click', function(e) {
            const list = document.getElementById('salesmenDropdownList');
            const selectorGroup = document.getElementById('salesmenFilterGroup');
            if (list && selectorGroup && !selectorGroup.contains(e.target)) {
                list.style.display = 'none';
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            toggleFilterType();
        });
    </script>

    <style>
        .btn-preset {
            background: rgba(214, 51, 108, 0.03);
            border: 1px solid var(--accent-border);
            color: var(--text-secondary);
            padding: 5px 15px;
            border-radius: 10px;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.2s;
            font-weight: 600;
        }
        .btn-preset:hover {
            background: var(--accent-color);
            color: white;
            border-color: var(--accent-color);
            transform: translateY(-2px);
        }
    </style>

    <style>
        /* Modern Loading Overlay */
        #printOverlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(255, 245, 248, 0.95);
            backdrop-filter: blur(10px);
            z-index: 9999;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--text-primary);
            transition: all 0.3s ease;
        }
        .loader-spinner {
            width: 50px; height: 50px;
            border: 3px solid rgba(214, 51, 108, 0.1);
            border-top: 3px solid var(--accent-color);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        /* Hide print elements by default on screen */
        .only-print, .only-print-analytics, .standard-print { display: none; }

        @media screen {
            /* Make it visible but off-screen during preparation for Chart.js to render */
            body.print-mode-analytics .only-print-analytics { 
                display: block !important; 
                position: absolute; 
                left: -9999px;
                width: 1200px;
            }
        }

        @media print {
            /* Basic resets */
            .no-print, #printOverlay, .sidebar, .mobile-header, .main-content > *:not(.only-print):not(.only-print-analytics):not(.standard-print) { 
                display: none !important; 
            }
            
            /* Main Content Reset */
            .main-content { 
                margin: 0 !important; 
                padding: 0 !important; 
                width: 100% !important;
                display: block !important;
            }

            /* Standard Mode (Default) */
            body.print-mode-standard .only-print,
            body.print-mode-standard .standard-print,
            body:not(.print-mode-analytics) .only-print,
            body:not(.print-mode-analytics) .standard-print { 
                display: block !important; 
            }

            /* Analytical Mode */
            body.print-mode-analytics .only-print-analytics { 
                display: block !important; 
                visibility: visible !important;
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                background: white;
            }

            /* Page optimization */
            @page { 
                size: A4 landscape; 
                margin: 0.4cm !important; 
            }
        }
    </style>

    <!-- Loading Overlay -->
    <div id="printOverlay">
        <div class="loader-spinner"></div>
        <h3 style="margin: 0; font-weight: 500;"><%= __('preparingAnalyticalReport') %></h3>
        <p style="margin-top: 10px; opacity: 0.7; font-size: 0.9rem;"><%= __('pleaseWaitChartAccuracy') %></p>
    </div>

    <script>
        let charts = {};

        // Flatpickr Setup
        const commonConfig = {
            locale: "<%= lang %>",
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "j F Y",
        };

        const startPicker = flatpickr("#startDate", commonConfig);
        const endPicker = flatpickr("#endDate", commonConfig);

        function setPreset(type) {
            const today = new Date();
            let start = new Date();
            let end = new Date();
            switch(type) {
                case 'today': break;
                case 'yesterday':
                    start.setDate(today.getDate() - 1);
                    end.setDate(today.getDate() - 1);
                    break;
                case 'week': start.setDate(today.getDate() - 7); break;
                case 'month': start.setDate(1); break;
            }
            startPicker.setDate(start);
            endPicker.setDate(end);
            document.getElementById('filterForm').submit();
        }

        async function printAnalyticalReport() {
            const overlay = document.getElementById('printOverlay');
            overlay.style.display = 'flex';
            
            // Quick sync for overlay
            await new Promise(r => setTimeout(r, 50));

            const container = document.getElementById('analyticalPrintView');
            document.body.classList.add('print-mode-analytics');
            
            // Destroy existing charts
            Object.values(charts).forEach(chart => chart.destroy());

            // Data Preparation
            const jsGrandTotal = <%= grandTotal %>;
            const statusData = [
                <%= totalFresh %>, <%= totalHot %>, <%= totalMeeting + totalSchedule %>, <%= totalCallback %>, 
                <%= totalFollowUp + totalLow %>, <%= totalProspect %>, <%= totalEOI %>, <%= totalDone %>,
                <%= Math.max(0, grandTotal - (totalFresh + totalHot + totalMeeting + totalSchedule + totalCallback + totalFollowUp + totalLow + totalProspect + totalEOI + totalDone)) %>
            ];
            const statusLabels = ['Fresh', 'Hot Case', 'Meeting', 'Call Back', 'Follow Up', 'Prospect', 'EOI', 'Done Deal', '<%= lang === "en" ? "Not Interested/Wrong" : "غير مهتم/خطأ" %>'];
            const salesmenData = <%- JSON.stringify(summary) %>;


            const chartOptions = { 
                animation: false, 
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { labels: { color: '#000', font: { size: 14, weight: 'bold' } } } 
                } 
            };

            // Status Chart with Data Labels Plugin
            charts.status = new Chart(document.getElementById('statusChart'), {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusData,
                        backgroundColor: [
                            '#0F172A', '#1E3A8A', '#3B82F6', '#64748B', 
                            '#60A5FA', '#F59E0B', '#0D9488', '#115E59', '#94A3B8'
                        ],
                        borderWidth: 2, borderColor: '#fff'
                    }]
                },
                options: { 
                    ...chartOptions, 
                    plugins: { 
                        legend: { 
                            position: 'bottom', 
                            labels: { 
                                boxWidth: 10, 
                                font: { size: 9 },
                                generateLabels: (chart) => {
                                    const data = chart.data;
                                    return data.labels.map((label, i) => ({
                                        text: `${label}: ${data.datasets[0].data[i]} (${((data.datasets[0].data[i] / jsGrandTotal) * 100).toFixed(1)}%)`,
                                        fillStyle: data.datasets[0].backgroundColor[i],
                                        strokeStyle: data.datasets[0].borderColor,
                                        lineWidth: data.datasets[0].borderWidth,
                                        hidden: false,
                                        index: i
                                    }));
                                }
                            } 
                        },
                    } 
                },
                plugins: [{
                    id: 'customLabels',
                    afterDraw: (chart) => {
                        const ctx = chart.ctx;
                        chart.data.datasets.forEach((dataset, i) => {
                            const meta = chart.getDatasetMeta(i);
                            meta.data.forEach((element, index) => {
                                const data = dataset.data[index];
                                const percentageVal = (data / jsGrandTotal) * 100;
                                if (data === 0 || percentageVal < 4) return; // Hide labels for < 4% to avoid overlap
                                const percentage = percentageVal.toFixed(1) + '%';
                                
                                const { x, y } = element.tooltipPosition();
                                ctx.fillStyle = '#000';
                                ctx.font = 'bold 10px Arial';
                                ctx.textAlign = 'center';
                                ctx.textBaseline = 'middle';
                                ctx.fillText(`${data} (${percentage})`, x, y);
                            });
                        });
                    }
                }]
            });
 
            // Salesman Chart
            charts.salesman = new Chart(document.getElementById('salesmanChart'), {
                type: 'bar',
                data: {
                    labels: salesmenData.map(s => s.salesman_name || '<%= __('unknown') %>'),
                    datasets: [{
                        label: '<%= __('totalLeads') %>',
                        data: salesmenData.map(s => s.total),
                        backgroundColor: '#1E3A8A',
                        borderRadius: 4
                    }]
                },
                options: { 
                    ...chartOptions, 
                    indexAxis: 'y', 
                    layout: {
                        padding: {
                            left: 140, // Increased padding to ensure names are visible
                            right: 20,
                            top: 10,
                            bottom: 10
                        }
                    },
                    plugins: { 
                        legend: { display: false },
                        tooltip: { enabled: true }
                    },
                    scales: { 
                        x: { 
                            grid: { display: false }, 
                            ticks: { color: '#000', font: { weight: 'bold', size: 11 } } 
                        },
                        y: { 
                            grid: { display: false }, 
                            ticks: { 
                                color: '#000', 
                                font: { weight: '900', size: 12 }, // Extra bold and slightly larger
                                autoSkip: false,
                                crossAlign: 'far' // Ensure text aligns correctly for names
                            } 
                        }
                    }
                }
            });

            // Final Wait for Rendering (Reduced since animations are OFF)
            setTimeout(() => {
                window.print();
                document.body.classList.remove('print-mode-analytics');
                overlay.style.display = 'none';
            }, 500);
        }

        function printStandardReport() {
            document.body.classList.add('print-mode-standard');
            window.print();
            document.body.classList.remove('print-mode-standard');
        }
    </script>

    <!-- Summary Cards -->
    <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 3rem; gap: 1.5rem;">
        <div class="card stat-card" style="border-inline-start: 4px solid #10b981; border-right: none; border-left: none;">
            <div class="stat-label"><%= __('freshStates') %></div>
            <div class="stat-value"><%= totalFresh.toLocaleString(lang === 'en' ? 'en-US' : 'ar-EG') %></div>
            <div style="font-size: 0.8rem; color: #10b981;"><%= grandTotal > 0 ? (totalFresh/grandTotal*100).toFixed(1) : 0 %>% <%= lang === 'en' ? 'of total' : 'من الإجمالي' %></div>
        </div>
        <div class="card stat-card" style="border-inline-start: 4px solid #f59e0b; border-right: none; border-left: none;">
            <div class="stat-label">Hot Case</div>
            <div class="stat-value"><%= totalHot.toLocaleString(lang === 'en' ? 'en-US' : 'ar-EG') %></div>
            <div style="font-size: 0.8rem; color: #f59e0b;"><%= grandTotal > 0 ? (totalHot/grandTotal*100).toFixed(1) : 0 %>% <%= lang === 'en' ? 'hot cases' : 'نسبة الحرارة' %></div>
        </div>
        <div class="card stat-card" style="border-inline-start: 4px solid #3b82f6; border-right: none; border-left: none;">
            <div class="stat-label">Meetings</div>
            <div class="stat-value"><%= totalMeeting.toLocaleString(lang === 'en' ? 'en-US' : 'ar-EG') %></div>
            <div style="font-size: 0.8rem; color: #3b82f6;"><%= lang === 'en' ? 'successful' : 'تمت بنجاح' %></div>
        </div>
        <div class="card stat-card" style="border-inline-start: 4px solid var(--accent-color); border-right: none; border-left: none;">
            <div class="stat-label"><%= __('total') %></div>
            <div class="stat-value"><%= grandTotal.toLocaleString(lang === 'en' ? 'en-US' : 'ar-EG') %></div>
            <div style="font-size: 0.8rem; color: var(--text-secondary);"><%= lang === 'en' ? 'leads' : 'عميل مستهدف' %></div>
        </div>
    </div>

    <div class="card">
        <h2><%= __('customerStatesDistribution') %> (<%= lang === 'en' ? 'Percentages' : 'النسب المئوية' %>)</h2>
        <div style="display: flex; height: 12px; border-radius: 6px; overflow: hidden; margin-bottom: 1.5rem; background: rgba(255,255,255,0.05);">
            <% 
                const pFresh = grandTotal > 0 ? (totalFresh/grandTotal*100).toFixed(2) + '%' : '0%';
                const pHot = grandTotal > 0 ? (totalHot/grandTotal*100).toFixed(2) + '%' : '0%';
                const pMeeting = grandTotal > 0 ? (totalMeeting/grandTotal*100).toFixed(2) + '%' : '0%';
                const pCallback = grandTotal > 0 ? (totalCallback/grandTotal*100).toFixed(2) + '%' : '0%';
                const pOthersRaw = grandTotal > 0 ? Math.max(0, 100 - (parseFloat(pFresh) + parseFloat(pHot) + parseFloat(pMeeting) + parseFloat(pCallback))) : 0;
                const pOthers = pOthersRaw.toFixed(2) + '%';
            %>
            <div style="width: <%= pFresh %>; background: #10b981;"></div>
            <div style="width: <%= pHot %>; background: #ef4444;"></div>
            <div style="width: <%= pMeeting %>; background: #3b82f6;"></div>
            <div style="width: <%= pCallback %>; background: #f59e0b;"></div>
            <div style="width: <%= pOthers %>; background: rgba(255,255,255,0.1);"></div>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 20px; font-size: 0.85rem; color: var(--text-secondary);">
            <div style="display: flex; align-items: center; gap: 6px;"><span style="width: 8px; height: 8px; background: #10b981; border-radius: 2px;"></span> Fresh</div>
            <div style="display: flex; align-items: center; gap: 6px;"><span style="width: 8px; height: 8px; background: #ef4444; border-radius: 2px;"></span> Hot Case</div>
            <div style="display: flex; align-items: center; gap: 6px;"><span style="width: 8px; height: 8px; background: #3b82f6; border-radius: 2px;"></span> Meeting</div>
            <div style="display: flex; align-items: center; gap: 6px;"><span style="width: 8px; height: 8px; background: #f59e0b; border-radius: 2px;"></span> Call Back</div>
            <div style="display: flex; align-items: center; gap: 6px;"><span style="width: 8px; height: 8px; background: rgba(255,255,255,0.2); border-radius: 2px;"></span> <%= lang === 'en' ? 'Others' : 'أخرى' %></div>
        </div>
    </div>
</div>

